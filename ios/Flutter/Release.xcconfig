#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Dart-defines baked into release archives so Xcode Product → Archive
// works without needing CLI flags. Base64 of comma-joined KEY=VALUE pairs:
//   SENTRY_DSN=https://8734faaad83a8d8794a350af206a6e20@…/4511363319922768
//   SENTRY_ENVIRONMENT=production
// SENTRY_RELEASE is intentionally NOT baked here — sentry_flutter auto-detects
// the release from package info (bundleId@version+build), so it's always
// correct without a manual bump. (The old hand-maintained tag went stale at
// admin@1.0.0+18 while the app shipped 1.1.x — 2026-08-02.)
// Rebuild this string only on a DSN rotation:
//   printf "%s" "SENTRY_DSN=...,SENTRY_ENVIRONMENT=production" | base64
DART_DEFINES=U0VOVFJZX0RTTj1odHRwczovLzg3MzRmYWFhZDgzYThkODc5NGEzNTBhZjIwNmE2ZTIwQG80NTEwOTg0MzI4MjQ5MzQ0LmluZ2VzdC5kZS5zZW50cnkuaW8vNDUxMTM2MzMxOTkyMjc2OCxTRU5UUllfRU5WSVJPTk1FTlQ9cHJvZHVjdGlvbg==
